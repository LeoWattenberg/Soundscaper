PUBLIC_TRANSLATIONS_BASE_URL=https://translations.soundscaper.org/runtime/translations/audacity/4
# The product this build serves. Set it explicitly on every deployment; unset
# means soundscaper only so that an existing local `npm run build` keeps working.
SCAPE_PRODUCT=soundscaper
SOUNDSCAPER_SITE=https://soundscaper.org
FRAMESCAPER_SITE=https://framescaper.org
