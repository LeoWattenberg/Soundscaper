node_modules
.claude/worktrees/
dist/
.astro/
.wrangler/
test-results/
playwright-report/
coverage/
.nyc_output/
.desktop-build/
# Packaged Electron output: unpacked Chromium and Electron binaries, one entry
# per build target. A target added without its line here is gigabytes of
# binaries one `git add -A` away from the history, which is how
# desktop-lease-matrix came to be missing.
release/desktop/
release/desktop-handoff/
release/desktop-lease-matrix/
release/desktop-nightly-tests/
release/desktop-nightly-products/
release/milestone-5-package/
.env
.env.*
!.env.example
private/
# Model weights staged for mirroring. Hundreds of megabytes per model, already
# digest-pinned in config/local-model-catalog.json and served from the object
# store, so committing them would bloat the history for no recoverable value.
.model-mirror/
.docs-ai-cache/

# Provisioned by scripts/provision-interchange-conformance.mjs; reference readers, never shipped.
/vendor/interchange-conformance/

# Provisioned by scripts/provision-milestone-5-native-sources.mjs; ~80 MiB of pinned
# upstream archives plus their extracted trees. Digest-pinned in
# config/milestone-5-native-source-acquisitions.json and re-fetchable from there,
# so committing them would bloat the history for nothing and would redistribute
# third-party source the licensing gates have not cleared.
/vendor/milestone-5-native-sources/
