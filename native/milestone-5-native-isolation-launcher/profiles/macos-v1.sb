;; SPDX-License-Identifier: AGPL-3.0-only
(version 1)
(deny default)
(allow process-info*)
(allow signal (target self))
(allow sysctl-read)
;; Data-only transport over the launcher's explicitly inherited descriptors.
(allow file-read-data file-write-data (subpath "/dev/fd"))
;; Exact file literals are appended by the authenticated broker from reopened FDs.
