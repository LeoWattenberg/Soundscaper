set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64EC)
if(NOT IS_ABSOLUTE "${FRAMESCAPER_C_COMPILER}" OR NOT IS_ABSOLUTE "${FRAMESCAPER_CXX_COMPILER}")
	message(FATAL_ERROR "The recipe must supply absolute authenticated C and C++ compilers")
endif()
set(CMAKE_C_COMPILER "${FRAMESCAPER_C_COMPILER}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${FRAMESCAPER_CXX_COMPILER}" CACHE FILEPATH "" FORCE)
