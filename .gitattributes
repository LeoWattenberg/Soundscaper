# Desktop codec notices, license texts, and source manifests ship byte-for-byte
# and are verified against reviewed digests while staging. A CRLF checkout on a
# Windows runner changes those bytes and fails the stage, so pin them to LF.
/src/common/editor/*/NOTICE.md text eol=lf
/src/common/editor/*/SOURCE.md text eol=lf
/src/common/editor/*/source-manifest.json text eol=lf
/src/common/editor/*/licenses/*.txt text eol=lf
