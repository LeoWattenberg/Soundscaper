/*
	Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://assets.soundscaper.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://kw.media; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://assets.soundscaper.org https://translations.soundscaper.org; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://kw.media
	Cross-Origin-Opener-Policy: same-origin
	Cross-Origin-Embedder-Policy: credentialless
	Referrer-Policy: strict-origin-when-cross-origin
	X-Content-Type-Options: nosniff

# Cloudflare joins same-name headers from every matching rule. These document
# path shapes are deliberately disjoint so each response receives one policy.
# Every product deployment shares the isolation rule above byte for byte. The
# markers below are where scripts/generate-static-routes.mjs substitutes the
# document and service-worker rules of the one product a build serves.
# @product-document-rules@

/assets/*
	Cache-Control: public, max-age=31536000, immutable

/logo/*
	Cache-Control: no-cache

/offline-icons/*
	Cache-Control: no-cache

/manifest-*.webmanifest
	Cache-Control: no-cache

/offline-shell.json
	Cache-Control: no-store

# @product-worker-rules@
