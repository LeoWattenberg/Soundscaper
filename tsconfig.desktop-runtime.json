{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"declaration": false,
		"incremental": false,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"outDir": ".desktop-build/desktop-runtime",
		"paths": {},
		"rewriteRelativeImportExtensions": true,
		"rootDir": ".",
		"sourceMap": false,
		"types": ["node"]
	},
	"include": [
		"desktop/application-lifecycle.ts",
		"desktop/assistance-main-ipc.ts",
		"desktop/assistance-service.ts",
		"desktop/assistance-sherpa-recognizer.ts",
		"desktop/assistance-speech-runtime.ts",
		"desktop/linked-original-locator-validation.ts",
		"desktop/linked-video-locator-registry.ts",
		"desktop/linked-video-locator-store.ts",
		"desktop/local-model-catalog.ts",
		"desktop/local-model-download.ts",
		"desktop/local-model-store.ts",
		"desktop/main-window-recovery.ts",
		"desktop/project-library-abort.ts",
		"desktop/project-library-api.ts",
		"desktop/project-library-contract.ts",
		"desktop/project-library-database.ts",
		"desktop/project-library-editor-media-service.ts",
		"desktop/project-library-editor-service.ts",
		"desktop/project-library-file-inventory.ts",
		"desktop/project-library-host.ts",
		"desktop/project-library-writer-coordinator.ts",
		"desktop/project-library-media.ts",
		"desktop/project-library-persistence.ts",
		"desktop/project-library-v10-main-ipc.ts",
		"desktop/project-library-reclamation.ts",
		"desktop/project-library-projects.ts",
		"desktop/project-library-stage-inventory.ts",
		"desktop/project-library.ts",
		"src/common/editor/project-schema-version.ts",
		"src/common/editor/project-v12-validation.ts",
		"src/common/editor/scape-project-document.ts"
	],
	"exclude": ["dist", "node_modules", "test-results"]
}
