{
	"all": true,
	"extension": [".js", ".cjs", ".mjs", ".ts", ".cts", ".mts", ".jsx", ".tsx"],
	"include": [
		"desktop/**/*.js",
		"desktop/**/*.cjs",
		"desktop/**/*.mjs",
		"desktop/**/*.ts",
		"desktop/**/*.cts",
		"desktop/**/*.mts",
		"desktop/**/*.jsx",
		"desktop/**/*.tsx",
		"src/**/*.js",
		"src/**/*.cjs",
		"src/**/*.mjs",
		"src/**/*.ts",
		"src/**/*.cts",
		"src/**/*.mts",
		"src/**/*.jsx",
		"src/**/*.tsx"
	],
	"exclude": [
		"**/*.d.ts",
		"**/*.d.cts",
		"**/*.d.mts",
		"src/common/editor/**/native/**"
	]
}
