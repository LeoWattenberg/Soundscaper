{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "soundscaper",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-07-14",
	"d1_databases": [
		{
			"binding": "FREESOUND_OAUTH_DB",
			"database_name": "soundscaper-freesound-oauth",
			"database_id": "ed60e0b5-b0b6-45e1-8024-d88a56169c54",
			"preview_database_id": "FREESOUND_OAUTH_DB",
			"migrations_dir": "migrations/freesound-oauth"
		}
	],
	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "FREESOUND_OAUTH_DB",
					"database_name": "soundscaper-audiocom-preview",
					"database_id": "ae64638c-39d8-4611-9fc1-2df762191d61",
					"preview_database_id": "FREESOUND_OAUTH_DB",
					"migrations_dir": "migrations/freesound-oauth"
				}
			]
		}
	}
}
