{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/typescript/app.tsbuildinfo",
		"types": ["vite/client"]
	},
	"include": ["functions/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "src/vite-env.d.ts"],
	"exclude": ["dist", "node_modules", "functions/worker-configuration.d.ts"]
}
